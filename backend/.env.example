# Django
# Generate a unique value for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.com
DJANGO_CORS_ALLOW_ALL=0
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_LOG_LEVEL=WARNING
LOGIN_LOCKOUT_MAX_FAILURES=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sme_scoring
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=db
DB_PORT=5432

# Docker Postgres initialization
POSTGRES_DB=sme_scoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-the-same-strong-password
