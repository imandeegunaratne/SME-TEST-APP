# Copy these values into a private .env file on the AWS host.
# Do not commit real production secrets.

POSTGRES_DB=sme_scoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-random-password

BACKEND_IMAGE=imandee_sme_test_app-backend:latest
APP_PORT=8000

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-unique-django-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.com
DJANGO_CORS_ALLOW_ALL=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_LOG_LEVEL=WARNING

LOGIN_LOCKOUT_MAX_FAILURES=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
