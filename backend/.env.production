# --- Django security ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret-key
DJANGO_ALLOWED_HOSTS=sme-scoring.institute.lk,203.xxx.xxx.xxx
DJANGO_CSRF_TRUSTED_ORIGINS=https://sme-scoring.institute.lk
DJANGO_CORS_ALLOWED_ORIGINS=https://sme-scoring.institute.lk
DJANGO_CORS_ALLOW_ALL=0
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_LOG_LEVEL=WARNING
LOGIN_LOCKOUT_MAX_FAILURES=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# --- Database ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bank_sme_scoring
DB_USER=prod_db_manager
DB_PASSWORD=replace-with-a-strong-production-password
DB_HOST=db
DB_PORT=5432

# --- Docker Postgres initialization ---
POSTGRES_DB=bank_sme_scoring
POSTGRES_USER=prod_db_manager
POSTGRES_PASSWORD=replace-with-the-same-strong-production-password
